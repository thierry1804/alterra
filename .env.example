# Copy to backend/.env for local dev
# cp .env.example backend/.env

# --- PostgreSQL (docker-compose postgres service, port 5433) ---
DATABASE_URL="postgresql://alterra:alterra_dev@localhost:5433/alterra"

# --- Redis (docker-compose redis service, port 6380) ---
REDIS_URL="redis://localhost:6380"

# --- MinIO object storage (docker-compose minio service) ---
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY="alterra_admin"
MINIO_SECRET_KEY="alterra_dev_secret"
MINIO_BUCKET_PHOTOS="photos-pointages"
MINIO_BUCKET_REPORTS="rapports-pdf"

# --- JWT (change in production — min 256 bits) ---
JWT_SECRET="change-me-256-bits-minimum-dev-only-secret-value"
JWT_REFRESH_SECRET="change-me-256-bits-minimum-dev-only-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# --- Server ---
NODE_ENV="development"
PORT=3001
LOG_LEVEL="debug"

# CORS — plusieurs origines possibles (séparées par des virgules) pour accès LAN
ADMIN_ORIGIN="http://localhost:5173,http://192.168.1.131:5173"
PWA_ORIGIN="http://localhost:5174,http://192.168.1.131:5174"

MAX_UPLOAD_SIZE_MB=5
