<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <title>Facture {{invoiceNumber}} — {{site.name}}</title>
    <style>
      body {
        font-family: ui-sans-serif, system-ui, "Liberation Sans", Arial, sans-serif;
        font-size: 11px;
        color: #18181b;
        margin: 32px;
      }
      .num {
        font-family: ui-monospace, "SFMono-Regular", "Liberation Mono", Menlo, Consolas, monospace;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
      }
      h1.invoice-title {
        font-size: 20px;
        text-align: center;
        margin: 0 0 4px;
      }
      .invoice-date {
        text-align: center;
        margin: 0 0 20px;
      }
      .label {
        font-weight: 700;
        text-decoration: underline;
      }
      .invoice-meta {
        display: grid;
        grid-template-columns: 1fr auto;
        column-gap: 24px;
        margin-bottom: 20px;
      }
      .invoice-fields .field {
        margin: 0 0 4px;
      }
      .client-block p {
        margin: 0 0 2px;
      }
      .client-block .name {
        font-weight: 700;
        font-size: 13px;
      }
      h2.activity {
        font-size: 12px;
        margin: 16px 0 6px;
      }
      table {
        width: 100%;
        table-layout: fixed;
        border-collapse: collapse;
        margin-bottom: 8px;
        font-size: 9.5px;
      }
      th,
      td {
        border: 1px solid #d4d4d8;
        padding: 5px 7px;
        text-align: left;
      }
      th {
        background: #f4f4f5;
        text-align: center;
      }
      td.num {
        text-align: right;
      }
      tfoot td,
      .total td {
        font-weight: 700;
        background: #f4f4f5;
      }
      .signature {
        margin-top: 28px;
        font-size: 10px;
        color: #52525b;
      }
    </style>
  </head>
  <body>
    <h1 class="invoice-title">FACTURE N° {{invoiceNumber}}</h1>
    <p class="invoice-date"><span class="label">DATE :</span> {{invoiceDate}}</p>

    <div class="invoice-meta">
      <div class="invoice-fields">
        <p class="field"><span class="label">SITE :</span> {{site.name}} ({{site.shortCode}})</p>
        <p class="field"><span class="label">MOTIF :</span> {{motif}}</p>
      </div>
      <div class="client-block">
        <p class="label">Doit :</p>
        <p class="name">{{client.name}}</p>
        <p>NIF : {{client.nif}}</p>
        <p>STAT : {{client.stat}}</p>
        <p>{{client.addressLine1}}</p>
        <p>{{client.addressLine2}}</p>
      </div>
    </div>

    {{#each activities}}
      <h2 class="activity">{{code}} — {{label}}</h2>
      <table>
        <colgroup>
          <col style="width: 4%" />
          <col style="width: 11%" />
          <col style="width: 12%" />
          <col style="width: 23%" />
          <col style="width: 8%" />
          <col style="width: 7%" />
          <col style="width: 8%" />
          <col style="width: 9%" />
          <col style="width: 9%" />
          <col style="width: 9%" />
        </colgroup>
        <thead>
          <tr>
            <th>N°</th>
            <th>Matricule</th>
            <th>N° CIN</th>
            <th>Désignation</th>
            <th>Quantité</th>
            <th>Unité</th>
            <th>P.U (Ar)</th>
            <th>Total (Ar)</th>
            <th>ISI {{isiRate}}% (Ar)</th>
            <th>Net à payer (Ar)</th>
          </tr>
        </thead>
        <tbody>
          {{#each lines}}
            <tr>
              <td class="num">{{rowNumber}}</td>
              <td class="num">{{matricule}}</td>
              <td class="num">{{cinNumber}}</td>
              <td>{{designation}}</td>
              <td class="num">{{quantity}}</td>
              <td>{{unit}}</td>
              <td class="num">{{unitPrice}}</td>
              <td class="num">{{amount}}</td>
              <td class="num">{{isiAmount}}</td>
              <td class="num">{{netAmount}}</td>
            </tr>
          {{/each}}
        </tbody>
        <tfoot>
          <tr>
            <td colspan="7">Sous-total · {{label}}</td>
            <td class="num">{{subtotal}}</td>
            <td class="num">{{isiSubtotal}}</td>
            <td class="num">{{netSubtotal}}</td>
          </tr>
        </tfoot>
      </table>
    {{/each}}

    <table>
      <colgroup>
        <col style="width: 4%" />
        <col style="width: 11%" />
        <col style="width: 12%" />
        <col style="width: 23%" />
        <col style="width: 8%" />
        <col style="width: 7%" />
        <col style="width: 8%" />
        <col style="width: 9%" />
        <col style="width: 9%" />
        <col style="width: 9%" />
      </colgroup>
      <tbody>
        <tr class="total">
          <td colspan="7">TOTAL · {{totals.workerCount}} travailleur(s)</td>
          <td class="num">{{totals.gross}}</td>
          <td class="num">{{totals.isi}}</td>
          <td class="num">{{totals.net}}</td>
        </tr>
      </tbody>
    </table>

    <p class="signature">
      Généré le
      {{generatedAt}}
      · Bordereau
      {{periodLabel}}
      · version
      {{version}}
    </p>
  </body>
</html>