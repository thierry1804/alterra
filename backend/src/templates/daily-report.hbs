<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <title>Rapport journalier — {{site.name}}</title>
  <style>
    body { font-family: Georgia, "Times New Roman", serif; font-size: 11px; color: #18181b; margin: 32px; }
    h1 { font-size: 18px; margin: 0 0 4px; }
    h2 { font-size: 13px; margin: 20px 0 8px; border-bottom: 1px solid #d4d4d8; padding-bottom: 4px; }
    .meta { color: #52525b; margin-bottom: 16px; }
    .summary { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 16px; }
    .summary div { border: 1px solid #d4d4d8; padding: 8px 10px; }
    .summary strong { display: block; font-size: 15px; margin-top: 4px; }
    table { width: 100%; border-collapse: collapse; margin-bottom: 12px; }
    th, td { border: 1px solid #d4d4d8; padding: 5px 7px; text-align: left; }
    th { background: #f4f4f5; font-weight: 600; }
    .anomalies { margin: 12px 0; padding: 8px 10px; border: 1px solid #d4d4d8; background: #fafafa; }
    .signature { margin-top: 28px; font-size: 10px; color: #52525b; }
  </style>
</head>
<body>
  <h1>Rapport journalier — {{site.name}} ({{site.shortCode}})</h1>
  <p class="meta">
    Journée {{date}} · Période {{periodIso}} · Généré le {{generatedAt}}
  </p>

  <div class="summary">
    <div>MOC actifs<strong>{{summary.workerCount}}</strong></div>
    <div>Pointages validés<strong>{{summary.pointageCount}}</strong></div>
    <div>Montant total<strong>{{summary.totalAmount}} Ar</strong></div>
    <div>Bio OK<strong>{{summary.bioOkCount}}</strong></div>
    <div>Bio en attente<strong>{{summary.bioPendingCount}}</strong></div>
  </div>

  {{#if summary.pendingCount}}
  <div class="anomalies">
    Pointages encore en attente : {{summary.pendingCount}} · Précisions : {{summary.needsClarificationCount}} · Rejetés : {{summary.rejectedCount}}
  </div>
  {{else}}
  {{#if summary.needsClarificationCount}}
  <div class="anomalies">
    Pointages encore en attente : {{summary.pendingCount}} · Précisions : {{summary.needsClarificationCount}} · Rejetés : {{summary.rejectedCount}}
  </div>
  {{/if}}
  {{/if}}

  {{#each activities}}
  <h2>{{label}}</h2>
  <table>
    <thead>
      <tr>
        <th>MOC</th>
        <th>Quantité</th>
        <th>Unité</th>
        <th>Montant (Ar)</th>
        <th>Bio</th>
      </tr>
    </thead>
    <tbody>
      {{#each rows}}
      <tr>
        <td>{{workerName}}</td>
        <td>{{quantity}}</td>
        <td>{{unit}}</td>
        <td>{{amount}}</td>
        <td>{{bioStatus}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{/each}}

  <p class="signature">
    Clôturé et signé électroniquement par {{cds.fullName}} · {{cds.signatureText}} · {{cds.signedAt}}
  </p>
</body>
</html>
