<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <title>Facture hebdomadaire — {{site.name}}</title>
  <style>
    body { font-family: Georgia, "Times New Roman", serif; font-size: 11px; color: #18181b; margin: 32px; }
    h1 { font-size: 20px; margin: 0 0 4px; }
    .meta { color: #52525b; margin-bottom: 24px; }
    table { width: 100%; border-collapse: collapse; margin-bottom: 16px; }
    th, td { border: 1px solid #d4d4d8; padding: 6px 8px; text-align: left; }
    th { background: #f4f4f5; }
    .total { font-size: 14px; font-weight: 700; text-align: right; margin-top: 16px; }
    .signature { margin-top: 32px; font-size: 10px; color: #52525b; }
  </style>
</head>
<body>
  <h1>Facture hebdomadaire — {{site.name}} ({{site.shortCode}})</h1>
  <p class="meta">
    Période {{periodLabel}} · Semaine {{weekIso}} · {{dateFrom}} → {{dateTo}}
  </p>

  <table>
    <thead>
      <tr>
        <th>MOC</th>
        <th>MVola</th>
        <th>Description</th>
        <th>Bio validée</th>
        <th>Montant (Ar)</th>
      </tr>
    </thead>
    <tbody>
      {{#each payments}}
      <tr>
        <td>{{workerName}}</td>
        <td>{{mvolaNumber}}</td>
        <td>{{description}}</td>
        <td>{{bioValid}}</td>
        <td>{{amount}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <p class="total">Total : {{summary.totalAmount}} Ar · {{summary.paymentCount}} ligne(s)</p>

  <p class="signature">
    Émis pour clôture semaine · Signé électroniquement par {{cds.fullName}} · {{cds.signedAt}}
  </p>
</body>
</html>
