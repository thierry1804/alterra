<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <title>Facture hebdomadaire {{activity.code}} — {{site.name}}</title>
    <style>
      body {
        font-family: Georgia, "Times New Roman", serif;
        font-size: 11px;
        color: #18181b;
        margin: 32px;
      }
      h1 {
        font-size: 20px;
        margin: 0 0 4px;
      }
      .meta {
        color: #52525b;
        margin-bottom: 24px;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 16px;
      }
      th,
      td {
        border: 1px solid #d4d4d8;
        padding: 6px 8px;
        text-align: left;
      }
      th {
        background: #f4f4f5;
      }
      .total {
        font-size: 14px;
        font-weight: 700;
        text-align: right;
        margin-top: 16px;
      }
      .num {
        text-align: right;
      }
      table {
        page-break-inside: auto;
      }
      tr {
        page-break-inside: avoid;
      }
      .signature {
        margin-top: 32px;
        font-size: 10px;
        color: #52525b;
      }
    </style>
  </head>
  <body>
    <h1>Facture hebdomadaire — {{activity.code}} {{activity.label}}</h1>
    <p class="meta">
      {{site.name}}
      ({{site.shortCode}}) · Période
      {{periodLabel}}
      · Semaine
      {{weekIso}}
      ·
      {{dateFrom}}
      →
      {{dateTo}}
    </p>
    <table>
      <thead>
        <tr>
          <th>MOC</th>
          <th>Tâche</th>
          <th class="num">Quantité</th>
          <th>Unité</th>
          <th class="num">Tarif (Ar)</th>
          <th class="num">Montant (Ar)</th>
        </tr>
      </thead>
      <tbody>
        {{#each activity.lines}}
          <tr>
            <td>{{workerName}}</td>
            <td>{{subActivityLabel}}</td>
            <td class="num">{{quantity}}</td>
            <td>{{unit}}</td>
            <td class="num">{{unitRate}}</td>
            <td class="num">{{amount}}</td>
          </tr>
        {{/each}}
      </tbody>
    </table>
    <p class="total">
      Total
      {{activity.code}}
      :
      {{activity.subtotal}}
      Ar ·
      {{activity.workerCount}}
      MOC
    </p>
    <p class="signature">
      Émis pour clôture semaine · Signé électroniquement par
      {{cds.fullName}}
      ·
      {{cds.signedAt}}
    </p>
  </body>
</html>