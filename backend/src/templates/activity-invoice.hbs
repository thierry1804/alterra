<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <title>Facture — {{activity.label}}</title>
    <style>
      body {
        /* Même pile que l'admin (admin/src/index.css) : police système, pas de serif distinctive. */
        font-family: ui-sans-serif, system-ui, "Liberation Sans", Arial, sans-serif;
        font-size: 11px;
        color: #18181b;
        margin: 32px;
      }
      .num {
        font-family: ui-monospace, "SFMono-Regular", "Liberation Mono", Menlo, Consolas, monospace;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
      }
      h1.invoice-title {
        font-size: 20px;
        text-align: center;
        margin: 0 0 4px;
      }
      .invoice-date {
        text-align: center;
        margin: 0 0 20px;
      }
      .invoice-date .label {
        font-weight: 700;
        text-decoration: underline;
      }
      .invoice-meta {
        display: grid;
        grid-template-columns: 1fr auto;
        grid-template-rows: auto auto;
        column-gap: 24px;
        row-gap: 12px;
        margin-bottom: 20px;
      }
      .client-block {
        grid-column: 2;
        grid-row: 1;
        text-align: left;
        font-size: 11px;
      }
      .invoice-fields {
        grid-column: 1;
        grid-row: 2;
        align-self: start;
      }
      .invoice-fields .field {
        margin-bottom: 4px;
      }
      .invoice-fields .label {
        font-weight: 700;
        text-decoration: underline;
      }
      .client-block .label {
        font-weight: 700;
      }
      .client-block .name {
        font-weight: 700;
        font-size: 13px;
        margin-top: 2px;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 16px;
        font-size: 9.5px;
      }
      th,
      td {
        border: 1px solid #d4d4d8;
        padding: 6px 8px;
        text-align: left;
      }
      th {
        background: #f4f4f5;
        text-align: center;
      }
      td.num {
        text-align: right;
      }
      tfoot td {
        font-weight: 700;
        background: #f4f4f5;
      }
      .signature {
        margin-top: 32px;
        font-size: 10px;
        color: #52525b;
      }
    </style>
  </head>
  <body>
    <h1 class="invoice-title">FACTURE N° {{invoiceNumber}}</h1>
    <p class="invoice-date"><span class="label">DATE :</span> {{invoiceDate}}</p>

    <div class="invoice-meta">
      <div class="invoice-fields">
        <p class="field"><span class="label">SITE :</span> {{site.name}} ({{site.shortCode}})</p>
        <p class="field"><span class="label">MOTIF :</span> {{motif}}</p>
      </div>
      <div class="client-block">
        <p class="label">Doit :</p>
        <p class="name">{{client.name}}</p>
        <p>NIF : {{client.nif}}</p>
        <p>STAT : {{client.stat}}</p>
        <p>{{client.addressLine1}}</p>
        <p>{{client.addressLine2}}</p>
      </div>
    </div>

    <table>
      <thead>
        <tr>
          <th>N°</th>
          <th>Matricule</th>
          <th>N° CIN</th>
          <th>Désignation</th>
          <th>Quantité</th>
          <th>P.U ({{activity.unit}})</th>
          <th>Total (Ar)</th>
          <th>ISI 5% (Ar)</th>
          <th>Net à payer (Ar)</th>
        </tr>
      </thead>
      <tbody>
        {{#each lines}}
          <tr>
            <td class="num">{{rowNumber}}</td>
            <td class="num">{{matricule}}</td>
            <td class="num">{{cinNumber}}</td>
            <td>{{designation}}</td>
            <td class="num">{{quantity}}</td>
            <td class="num">{{unitPrice}}</td>
            <td class="num">{{amount}}</td>
            <td class="num">{{isiAmount}}</td>
            <td class="num">{{netAmount}}</td>
          </tr>
        {{/each}}
      </tbody>
      <tfoot>
        <tr>
          <td colspan="6">TOTAL · {{summary.workerCount}} travailleur(s)</td>
          <td class="num">{{summary.totalAmount}}</td>
          <td class="num">{{summary.isiAmount}}</td>
          <td class="num">{{summary.netAmount}}</td>
        </tr>
      </tfoot>
    </table>

    <p class="signature">Généré le {{generatedAt}} · Export MVola {{periodLabel}}</p>
  </body>
</html>