# Copy to .env.prod on the production host (never commit secrets)
# cp .env.prod.example .env.prod

NODE_ENV=production
PORT=3001
LOG_LEVEL=info

DATABASE_URL="postgresql://alterra:CHANGE_ME@postgres:5432/alterra"
REDIS_URL="redis://redis:6379"

MINIO_ENDPOINT="minio"
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY="CHANGE_ME"
MINIO_SECRET_KEY="CHANGE_ME"
MINIO_BUCKET_PHOTOS="photos-pointages"
MINIO_BUCKET_REPORTS="rapports-pdf"

JWT_SECRET="CHANGE_ME_256_BITS_MINIMUM"
JWT_REFRESH_SECRET="CHANGE_ME_256_BITS_MINIMUM_REFRESH"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

MFA_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

ADMIN_ORIGIN="https://admin.alterra.mg"
PWA_ORIGIN="https://app.alterra.mg"

MAX_UPLOAD_SIZE_MB=5

BIOMETRIC_PROVIDER="MANUAL"
AXIAN_API_URL="https://biometric.axian.mg/api/v1/kyc/compare"
AXIAN_API_KEY=""
AXIAN_MATCH_THRESHOLD="0.85"

PDF_WORKER_ENABLED="true"
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""
MAILGUN_FROM="ALTERRA <noreply@alterra.mg>"

# Host cron backup-offsite.sh (not in container env)
# HEALTHCHECK_URL=https://hc-ping.com/your-uuid
# RCLONE_REMOTE=b2crypt:alterra-backups
