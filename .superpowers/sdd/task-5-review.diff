+    it("getTeamFilter returns empty for CHEF_SERVICE", () => {
+      runWithRequestContext(
+        { role: Role.CHEF_SERVICE, siteId: MOCK_SITE_ID, teamId: MOCK_TEAM_ID },
+        () => {
+          expect(getTeamFilter()).toEqual({});
+        },
+      );
