+      expect(basePrisma.auditLog.create).toHaveBeenCalledWith({
+        data: {
+          userId: MOCK_CDS_ID,
+          action: "CREATE",
+          entityType: "Worker",
+          entityId: "worker-1",
+          before: undefined,
+          after: { id: "worker-1", matricule: "W001" },
+          ip: "127.0.0.1",
+          userAgent: "vitest",
+        },
+      });
+    });
+  });
+});
