+        userId: MOCK_CDS_ID,
+        action: "CREATE",
+        entityType: "Worker",
+        entityId: "worker-1",
+        before: null,
+        after: { id: "worker-1" },
+        ip: "127.0.0.1",
+        userAgent: "vitest",
